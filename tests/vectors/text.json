  {"fn": "fold", "args": ["Straße"], "opts": {"keep_length": false}, "expect": "strasse"},
  {"fn": "fold", "args": ["İstanbul"], "expect": "istanbul"},
  {"fn": "fold", "args": [null], "expect": ""},
  {"fn": "slugify", "args": ["¡Hola, Mundo! Café con leche"], "expect": "hola-mundo-cafe-con-leche"},
  {"fn": "slugify", "args": ["  ---  "], "opts": {"fallback": "x"}, "expect": "x"},
  {"fn": "slugify", "args": ["uno dos tres cuatro cinco seis"], "opts": {"max_len": 14}, "expect": "uno-dos-tres"},
  {"fn": "slugify", "args": ["Mutua Madrileña S.A."], "opts": {"sep": "_"}, "expect": "mutua_madrilena_s_a"},
  {"fn": "safe_filename", "args": ["Factura: enero/2026?.pdf"], "expect": "Factura_ enero_2026_.pdf"},
  {"fn": "safe_filename", "args": ["CON.txt"], "expect": "_CON.txt"},
  {"fn": "safe_filename", "args": ["   ...   "], "expect": "file"},
