  {"fn": "normalize_email", "args": ["no es un correo"], "expect": ""},
  {"fn": "normalize_phone", "args": ["612 34 56 78"], "expect": "+34612345678"},
  {"fn": "normalize_phone", "args": ["0034 612-345-678"], "expect": "+34612345678"},
  {"fn": "normalize_phone", "args": ["+44 (0)20 7946 0018"], "expect": "+4402079460018"},
  {"fn": "normalize_phone", "args": ["123"], "expect": ""},
  {"fn": "name_similarity", "args": ["José García", "garcia jose"], "expect": 1.0},
  {"fn": "name_similarity", "args": ["J. García", "Juan García"], "expect": 0.5},
  {"fn": "name_similarity", "args": ["Ana", "Pedro"], "expect": 0.0},
  {"fn": "domain_of", "args": ["https://www.Amazon.es/dp/B0?x=1"], "expect": "amazon.es"},
  {"fn": "domain_of", "args": ["Pedidos <pedidos@correo.pccomponentes.com>"], "expect": "correo.pccomponentes.com"},
